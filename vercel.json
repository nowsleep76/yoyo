{
  "version": 2,
  "builds": [
    {
      "src": "fishing-app/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/.*",
      "dest": "fishing-app/frontend/dist/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/.*",
      "dest": "fishing-app/frontend/dist/index.html"
    }
  ]
}
