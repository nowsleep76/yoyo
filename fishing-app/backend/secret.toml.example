# API 설정 - secret.toml에 복사해서 실제 API 키를 입력하세요
# 이 파일은 git에 커밋됩니다. secret.toml은 .gitignore에 등록됨

[api]
# 기상청 단기예보 조회서비스 키
# https://data.go.kr에서 활용신청 후 발급
kma_service_key = "your_kma_service_key_here"

# 국립해양조사원 해양관측정보 API 서비스키
# https://data.go.kr에서 활용신청 후 발급
khoa_service_key = "your_khoa_service_key_here"

# 바다낚시지수 API 서비스키
fishing_index_api_key = "your_fishing_index_api_key_here"

[app]
# Flask 환경
environment = "development"
debug = false
